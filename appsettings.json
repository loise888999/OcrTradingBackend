{
  "ConnectionStrings": {
    "Default": "Data Source=ocr-trading.db"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "OcrTradingBackend.Services.OcrCycleRunner": "Warning"
    }
  },

  "OcrSettings": {
    "Enabled": false,
    "UseEnglishModels": true,
    "FallbackToBundledModel": true,
    "DetectionModelPath": "",
    "ClassifierModelPath": "",
    "RecognitionModelPath": "Data/ocr-models/english/rec",
    "DictionaryPath": "Data/ocr-models/english/en_dict.txt",

    "DefaultIntervalSeconds": 1,
    "DefaultIntervalMilliseconds": 1000,

    "CityIntervalSeconds": 8,
    "PriceIntervalSeconds": 6,
    "ActivePriceIntervalSeconds": 1,
    "PriceFastModeSeconds": 20,

    "WorldWidth": 16384,
    "WorldHeight": 8192,
    "XZeroVisualOffset": 0,

    "CoordinateIntervalMilliseconds": 2000,
    "CoordinateRecentlyVisibleSeconds": 10,
    "CoordinateRequiresProbablyAtSea": true,
    "ProbablyAtSeaAfterNoCityOrMenuSeconds": 10,
    "MinCityNameLength": 3,

    "CoordinateOcrZoneName": "Coordinate",
    "CityOcrZoneName": "City",
    "PriceOcrZoneName": "Price",

    "EnableCoordinateCorrection": true,
    "MaxCoordinateJumpX": 31200,
    "MaxCoordinateJumpY": 33900,

    "CoordinateTryPreprocess": true,
    "CoordinateOcrUpscale": 2,

    "CityTryPreprocess": true,
    "CityOcrUpscale": 2,
    "CityOcrThreshold": 145,
    "CityOcrInvert": false,

    "PriceTryPreprocess": true,
    "PriceOcrUpscale": 2,
    "PriceOcrThreshold": 130,
    "PriceOcrInvert": false,

    "CoordinateForcePreprocess": false,
    "CityForcePreprocess": false,
    "PriceForcePreprocess": true,

    "SkipUnchangedOcrByHash": true,
    "UseSampleHashBeforeFullHash": true,
    "SampleHashStep": 8,
    "ForceFullHashEverySeconds": 3,

    "PriceBatchCaptureEnabled": true,
    "PriceBatchCaptureIntervalMs": 250,
    "PriceBatchFlushEverySeconds": 5,
    "PriceBatchIdleFlushSeconds": 0,
    "PriceBatchMaxImages": 50,

    "PriceRecentHashCacheEnabled": true,
    "PriceRecentHashCacheMinutes": 10,
    "PriceRecentHashCacheMaxEntries": 5000,

    "PriceMenuValidationEnabled": true,
    "PriceMenuValidationTopPercent": 25,
    "PriceMenuValidationUsePreprocess": true,
    "PriceMenuValidationValidWords": "Buy|Sell",
    "PriceCaptureBodyOnlyAfterMenuValidation": true,

    "OcrBenchmarkLogging": false,

    "SaveDebugImages": false,
    "DebugImageFolder": "Data/debug-ocr",

    "OcrLayoutDefaultPath": "Data/ocr-layout.default.json",
    "OcrLayoutLocalPath": "Data/ocr-layout.local.json",
    "PriceLayoutValidationPreprocess": true,
    "PriceLayoutFieldPreprocess": true,
    "PriceLayoutFieldFallbackEnabled": false,
    "PriceLayoutRowFingerprintTolerance": 10,
    "OcrTextPresenceGateMode": "BeforeAndAfter",
    "OcrTextPresenceMinContrast": 18,
    "OcrTextPresenceMinEdgePixelsPercent": 0.35,
    "OcrTextPresenceSampleStep": 3
  },

  "GameWindow": {
    "ProcessName": "",
    "ProcessNames": [],
    "TitleContains": "",
    "IncludeMinimized": true,
    "PreferMouseSelectedWindow": true
  },

  "AllowedHosts": "*",

  "MouseCalibration": {
    "OffsetX": 0,
    "OffsetY": 0
  }
}
