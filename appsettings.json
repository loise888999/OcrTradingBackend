{
  "ConnectionStrings": {
    "Default": "Data Source=ocr-trading.db"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "OcrTradingBackend.Services.OcrCycleRunner": "Warning"
    }
  },

  "OcrSettings": {
    "Enabled": false,
    "UseEnglishModels": true,
    "FallbackToBundledModel": true,
    "DetectionModelPath": "",
    "ClassifierModelPath": "",
    "RecognitionModelPath": "Data/ocr-models/english/rec",
    "DictionaryPath": "Data/ocr-models/english/en_dict.txt",

    "DefaultIntervalSeconds": 1,
    "DefaultIntervalMilliseconds": 750,

    "CityIntervalSeconds": 5,
    "PriceIntervalSeconds": 1,
    "ActivePriceIntervalSeconds": 1,
    "PriceFastModeSeconds": 20,

    "WorldWidth": 16384,
    "WorldHeight": 8192,
    "XZeroVisualOffset": 0,

    "CoordinateReadMode": "NormalOcr",
    "CoordinateTemplateFallbackToNormalOcr": false,
    "CoordinateTemplateCountFailedReadsForRecalibration": true,
    "CoordinateTemplateRecalibrationFailureLimit": 5,
    "CoordinateTemplateRequireVisibleTextForFailure": true,
    "CoordinateTemplateMinTextPixelsPercent": 0.35,
    "CoordinateTemplateMinContrast": 18,
    "CoordinateTemplateAutoProfileEnabled": false,
    "CoordinateTemplateAutoProfileOnlyWhenNormalOcrMode": true,
    "CoordinateTemplateAutoProfileMaxSamples": 200,
    "CoordinateTemplateAutoProfileValidationMaxDigitScore": 0.18,
    "CoordinateTemplateMaxTemplatesPerDigit": 5,
    "CoordinateTemplateRequirePerDigitOcrValidation": true,
    "CoordinateOcrSettingsPath": "Data/coordinate-ocr-settings.json",
    "CoordinateTemplateProfilePath": "Data/coordinate-template-profile.json",

    "CoordinateIntervalMilliseconds": 1500,
    "CoordinateRecentlyVisibleSeconds": 10,
    "CoordinateRequiresProbablyAtSea": true,
    "ProbablyAtSeaAfterNoCityOrMenuSeconds": 5,
    "MinCityNameLength": 3,

    "CoordinateOcrZoneName": "Coordinate",
    "CityOcrZoneName": "City",
    "PriceOcrZoneName": "Price",

    "EnableCoordinateCorrection": true,
    "MaxCoordinateJumpX": 12200,
    "MaxCoordinateJumpY": 9200,
    "CoordinateFarJumpConfirmationEnabled": true,
    "CoordinateFarJumpRequiredReads": 4,
    "CoordinateFarJumpClusterToleranceX": 100,
    "CoordinateFarJumpClusterToleranceY": 100,

    "CoordinateTryPreprocess": true,
    "CoordinateOcrUpscale": 2,
    "CoordinateOcrThreshold": 155,
    "OcrPreprocessCleanupEnabled": true,
    "CoordinatePreprocessCleanupEnabled": true,
    "CoordinatePreprocessRemoveSmallBlobsEnabled": true,
    "CoordinatePreprocessMinWhiteBlobPixels": 3,
    "CoordinatePreprocessTextShapeFilterEnabled": true,
    "CoordinatePreprocessMinTextLikeBlobWidth": 2,
    "CoordinatePreprocessMinTextLikeBlobHeight": 4,
    "CoordinatePreprocessMaxTextLikeBlobHeightPercent": 90,

    "CityTryPreprocess": true,
    "CityOcrUpscale": 2,
    "CityOcrThreshold": 145,
    "CityOcrInvert": false,

    "PriceTryPreprocess": true,
    "PriceOcrUpscale": 2,
    "PriceOcrThreshold": 125,
    "PriceOcrInvert": false,

    "CoordinateForcePreprocess": true,
    "CityForcePreprocess": false,
    "PriceForcePreprocess": true,

    "SkipUnchangedOcrByHash": true,
    "OcrFullHashCacheEnabled": true,
    "OcrFullHashCacheMinutes": 7,
    "OcrFullHashCacheMaxEntries": 5000,

    "PriceBatchCaptureEnabled": true,
    "PriceBatchCaptureIntervalMs": 250,
    "PriceBatchFlushEverySeconds": 5,
    "PriceBatchIdleFlushSeconds": 0,
    "PriceBatchMaxImages": 20,

    "PriceRecentHashCacheEnabled": true,
    "PriceRecentHashCacheMinutes": 10,
    "PriceRecentHashCacheMaxEntries": 5000,

    "PriceMenuValidationEnabled": true,
    "PriceMenuValidationTopPercent": 25,
    "PriceMenuValidationUsePreprocess": true,
    "PriceMenuValidationValidWords": "Buy|Sell",
    "PriceCaptureBodyOnlyAfterMenuValidation": true,

    "OcrBenchmarkLogging": false,

    "SaveDebugImages": true,
    "DebugImageFolder": "Data/debug-ocr",

    "OcrLayoutDefaultPath": "Data/ocr-layout.default.json",
    "OcrLayoutLocalPath": "Data/ocr-layout.local.json",
    "PriceLayoutValidationPreprocess": true,
    "PriceLayoutFieldPreprocess": true,
    "PriceLayoutFieldFallbackEnabled": false,
    "PriceLayoutRowFingerprintTolerance": 10,
    "OcrAllowedCharFilteringEnabled": true,
    "CoordinateOcrAllowedChars": "0123456789XYxy,:=. \r\n",
    "PriceNumberOcrAllowedChars": "0123456789,. \r\n",
    "PriceMultiplierOcrAllowedChars": "0123456789% \r\n",
    "PriceMenuOcrAllowedChars": "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz \r\n",
    "OcrTextPresenceGateMode": "BeforeAndAfter",
    "OcrTextPresenceMinContrast": 34,
    "OcrTextPresenceMinEdgePixelsPercent": 0.35,
    "OcrTextPresenceSampleStep": 3
  },

  "GameWindow": {
    "ProcessName": "",
    "ProcessNames": [],
    "TitleContains": "",
    "IncludeMinimized": true,
    "PreferMouseSelectedWindow": true
  },

  "AllowedHosts": "*",

  "MouseCalibration": {
    "OffsetX": 0,
    "OffsetY": 0
  }
}
